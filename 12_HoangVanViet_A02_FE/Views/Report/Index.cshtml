@{
    ViewData["Title"] = "Report Statistics";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">News Article Statistics Report</h2>
    <p class="text-secondary" style="font-size: 0.95rem;">Generate statistics on news articles created within a specified date period (sorted in descending order)</p>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4" style="border: 1px solid #e5e7eb !important;">
    <div class="card-body p-4 p-md-5">
        <div class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label text-secondary fw-medium fs-6"><i class="bi bi-calendar3 me-1"></i> Start Date</label>
                <div class="input-group">
                    <input type="date" class="form-control rounded-3 shadow-sm" id="startDate" style="border: 1px solid #d1d5db; padding: 0.6rem 0.75rem;">
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label text-secondary fw-medium fs-6"><i class="bi bi-calendar3 me-1"></i> End Date</label>
                <div class="input-group">
                    <input type="date" class="form-control rounded-3 shadow-sm" id="endDate" style="border: 1px solid #d1d5db; padding: 0.6rem 0.75rem;">
                </div>
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100 rounded-3 shadow-sm fw-medium d-flex align-items-center justify-content-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5; height: 45px;" onclick="generateReport()">
                    <i class="bi bi-bar-chart-fill"></i> Generate Report
                </button>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4" style="border: 2px solid #3b82f6; background-color: white;">
                    <p class="text-secondary fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">REPORT PERIOD</p>
                    <h5 class="fw-bold text-dark mb-0" id="reportPeriodText">--/--/---- &mdash; --/--/----</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4" style="border: 2px solid #16a34a; background-color: white;">
                    <p class="text-secondary fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">TOTAL ARTICLES PUBLISHED</p>
                    <h2 class="fw-bold mb-0" style="color: #16a34a;" id="totalArticlesText">0</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4" style="border: 2px solid #06b6d4; background-color: white;">
                    <p class="text-secondary fw-bold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">SORT ORDER</p>
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2"><i class="bi bi-sort-down" style="color: #06b6d4;"></i> CreatedDate Descending</h6>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-0" style="border-color: #f3f4f6 !important;">
            <h5 class="fw-bold text-dark mb-0">Detailed Article Records</h5>
            <span class="badge rounded-pill bg-light text-primary border px-3 py-2 fw-medium" id="recordsBadge" style="border-color: #bfdbfe !important;">0 records</span>
        </div>

        <div class="table-responsive rounded-bottom-3 border-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light text-secondary" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3 px-3 border-bottom-0">#</th>
                        <th class="py-3 px-3 border-bottom-0">CREATED DATE</th>
                        <th class="py-3 px-3 border-bottom-0 w-25">HEADLINE & TITLE</th>
                        <th class="py-3 px-3 border-bottom-0">CATEGORY</th>
                        <th class="py-3 px-3 border-bottom-0">AUTHOR (CREATED BY)</th>
                        <th class="py-3 px-3 border-bottom-0">STATUS</th>
                        <th class="py-3 px-3 border-bottom-0">TAGS</th>
                    </tr>
                </thead>
                <tbody id="reportTableBody" style="font-size: 0.85rem;">
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-folder-x display-4 d-block mb-3 text-muted"></i>
                            No articles found within the selected period.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatDateStr(dateStr) {
            const d = new Date(dateStr);
            return `${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}/${d.getFullYear()}`;
        }

        function generateReport() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            
            if(!startDate || !endDate){
                Swal.fire('Warning', 'Please select both start and end dates', 'warning');
                return;
            }
            if(new Date(startDate) > new Date(endDate)){
                Swal.fire('Warning', 'Start date cannot be after end date', 'warning');
                return;
            }

            document.getElementById('reportPeriodText').innerHTML = `${formatDateStr(startDate)} &mdash; ${formatDateStr(endDate)}`;

            $.get(`/Report/GetStatistics?startDate=${startDate}&endDate=${endDate}`, function(data) {
                const tbody = document.getElementById('reportTableBody');
                tbody.innerHTML = '';
                
                document.getElementById('totalArticlesText').innerText = data ? data.length : 0;
                document.getElementById('recordsBadge').innerText = `${data ? data.length : 0} records`;

                if(data && data.length > 0){
                    data.forEach((item, index) => {
                        const tr = document.createElement('tr');
                        tr.style.borderTop = "1px solid #f3f4f6";
                        
                        let tagsHtml = '';
                        if (item.newsTags && item.newsTags.length > 0) {
                            tagsHtml = '<div class="d-flex flex-wrap gap-1">';
                            item.newsTags.forEach(nt => {
                                tagsHtml += `<span class="badge bg-light text-secondary border px-2 py-1" style="font-weight: 400; font-size: 0.7rem;">#${nt.tag?.tagName || 'tag'}</span>`;
                            });
                            tagsHtml += '</div>';
                        }

                        tr.innerHTML = `
                            <td class="py-3 px-3 fw-medium text-secondary">${index + 1}</td>
                            <td class="py-3 px-3 fw-medium text-dark">${new Date(item.createdDate).toLocaleDateString()}</td>
                            <td class="py-3 px-3">
                                <p class="fw-bold text-dark mb-1" style="line-height: 1.3;">${item.newsTitle || ''}</p>
                                <p class="text-secondary mb-0" style="font-size: 0.75rem;">${item.headline || ''}</p>
                            </td>
                            <td class="py-3 px-3">
                                <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-folder2-open me-1"></i> ${item.category?.categoryName || 'Unknown'}</span>
                            </td>
                            <td class="py-3 px-3">
                                <span class="d-flex align-items-center gap-2"><i class="bi bi-person-circle text-secondary fs-5"></i> ${item.createdBy?.accountName || 'Unknown'}</span>
                            </td>
                            <td class="py-3 px-3">
                                ${item.newsStatus ? '<span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1"><i class="bi bi-check-circle me-1"></i> Active</span>' : '<span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1"><i class="bi bi-x-circle me-1"></i> Inactive</span>'}
                            </td>
                            <td class="py-3 px-3">${tagsHtml}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="bi bi-folder-x display-4 d-block mb-3 text-muted"></i>
                                No articles found within the selected period.
                            </td>
                        </tr>
                    `;
                }
            }).fail(function(err) {
                Swal.fire('Error', err.responseJSON?.message || 'Failed to fetch report', 'error');
            });
        }
    </script>
}
