@model _12_HoangVanViet_A02_FE.Models.NewsArticle

@{
    ViewData["Title"] = Model.NewsTitle;
}

<div class="container-fluid px-0 px-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm text-secondary border fw-medium">
                    <i class="bi bi-arrow-left me-2"></i> Back to News
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-5" style="border: 1px solid #e5e7eb !important;">
                <div class="card-body p-4 p-md-5">
                    <!-- Header -->
                    <div class="mb-4 text-center">
                        <span class="badge text-primary bg-primary bg-opacity-10 rounded-pill px-3 py-2 border border-primary border-opacity-25 fw-medium mb-3">
                            <i class="bi bi-folder2-open me-1"></i> @(Model.Category?.CategoryName ?? "General")
                        </span>
                        <h1 class="fw-bold text-dark mb-3" style="letter-spacing: -0.5px; line-height: 1.3;">@Model.NewsTitle</h1>
                        <h4 class="text-secondary fw-normal mb-4" style="line-height: 1.5;">@Model.Headline</h4>
                        
                        <div class="d-flex align-items-center justify-content-center gap-4 text-muted pt-3 border-top" style="border-color: #f3f4f6 !important;">
                            <span class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle fs-5"></i> <span class="fw-medium">@(Model.CreatedBy?.AccountName ?? "Unknown Author")</span>
                            </span>
                            <span class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar3"></i> <span>@Model.CreatedDate?.ToString("MMMM dd, yyyy")</span>
                            </span>
                            @if(!string.IsNullOrEmpty(Model.NewsSource))
                            {
                                <span class="d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-up-right"></i> Source: @Model.NewsSource
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="pt-4 border-top" style="border-color: #f3f4f6 !important;">
                        <p class="text-dark" style="font-size: 1.1rem; line-height: 1.8; white-space: pre-wrap;">@Model.NewsContent</p>
                    </div>

                    <!-- Footer / Tags -->
                    @if(Model.NewsTags != null && Model.NewsTags.Any())
                    {
                        <div class="mt-5 pt-4 border-top d-flex align-items-center flex-wrap gap-2" style="border-color: #f3f4f6 !important;">
                            <span class="text-muted fw-medium me-2"><i class="bi bi-tags me-1"></i> Tags:</span>
                            @foreach(var nt in Model.NewsTags)
                            {
                                <span class="badge bg-light text-secondary border px-3 py-2 fw-normal" style="font-size: 0.85rem;">#@nt.Tag?.TagName</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
