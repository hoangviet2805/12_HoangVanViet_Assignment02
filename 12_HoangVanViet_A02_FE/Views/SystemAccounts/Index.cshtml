@model IEnumerable<_12_HoangVanViet_A02_FE.Models.SystemAccount>

@{
    ViewData["Title"] = "Account Management";
}

<div class="card border-0 shadow-sm rounded-4 mb-4" style="border: 1px solid #e5e7eb !important;">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Account Management</h2>
                <p class="text-secondary mb-0" style="font-size: 0.95rem;">Manage system staff and lecturer accounts</p>
            </div>
            <div>
                <button class="btn btn-primary rounded-3 px-4 shadow-sm fw-medium d-flex align-items-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5; height: 42px;" onclick="openCreateModal()">
                    <i class="bi bi-person-plus-fill"></i> Add New Account
                </button>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-10">
                <div class="input-group border rounded-3 overflow-hidden shadow-sm" style="border-color: #e5e7eb !important;">
                    <span class="input-group-text bg-white border-0 ps-3 pe-2 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-0 ps-2" placeholder="Search by name or email..." style="box-shadow: none; font-size: 0.95rem; height: 42px;">
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100 rounded-3 shadow-sm fw-medium d-flex align-items-center justify-content-center gap-2" style="background-color: #4f46e5; border-color: #4f46e5; height: 42px;">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>

        <div class="table-responsive rounded-3 border" style="border-color: #e5e7eb !important;">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light text-secondary" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="py-3 px-4 border-bottom-0">ACCOUNT ID</th>
                        <th class="py-3 px-4 border-bottom-0">ACCOUNT NAME</th>
                        <th class="py-3 px-4 border-bottom-0">EMAIL</th>
                        <th class="py-3 px-4 border-bottom-0">ROLE</th>
                        <th class="py-3 px-4 border-bottom-0 text-center">CREATED ARTICLES</th>
                        <th class="py-3 px-4 border-bottom-0 text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.9rem;">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var account in Model)
                        {
                            <tr style="border-top: 1px solid #f3f4f6;">
                                <td class="py-3 px-4 fw-medium text-dark">#@account.AccountID</td>
                                <td class="py-3 px-4 fw-medium text-dark">@account.AccountName</td>
                                <td class="py-3 px-4 text-secondary">@account.AccountEmail</td>
                                <td class="py-3 px-4">
                                    @switch (account.AccountRole)
                                    {
                                        case 0:
                                            <span class="badge rounded-pill px-3 py-2 fw-medium" style="background-color: #fee2e2; color: #ef4444;"><i class="bi bi-shield-check me-1"></i> Admin</span>
                                            break;
                                        case 1:
                                            <span class="badge rounded-pill px-3 py-2 fw-medium" style="background-color: #f3f4f6; color: #4b5563;"><i class="bi bi-person me-1"></i> Staff</span>
                                            break;
                                        case 2:
                                            <span class="badge rounded-pill px-3 py-2 fw-medium" style="background-color: #4b5563; color: white;"><i class="bi bi-book me-1"></i> Lecturer</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark rounded-pill px-3 py-2">Unknown</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <span class="badge rounded-pill px-3 py-1 fw-medium" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                                        <i class="bi bi-journal-text me-1"></i> @(account.NewsArticles?.Count ?? 0) articles
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <button class="btn btn-sm rounded-3 fw-medium me-2" style="color: #6366f1; border: 1px solid #c7d2fe; background-color: white;" onclick="openEditModal(@account.AccountID)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn btn-sm rounded-3 fw-medium" style="color: #ef4444; border: 1px solid #fecaca; background-color: white;" onclick="deleteAccount(@account.AccountID)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No accounts found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Account Modal -->
<div class="modal fade" id="accountModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
        <h5 class="modal-title fw-bold" id="modalTitle">Create Account</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-4 pb-2 pt-3">
        <form id="accountForm">
            <input type="hidden" id="AccountID" />
            <div class="mb-3">
                <label class="form-label text-secondary fw-medium fs-6">Name</label>
                <input type="text" class="form-control rounded-3 shadow-sm border-gray" id="AccountName" required maxlength="100" style="padding: 0.6rem 0.75rem;">
            </div>
            <div class="mb-3">
                <label class="form-label text-secondary fw-medium fs-6">Email</label>
                <input type="email" class="form-control rounded-3 shadow-sm border-gray" id="AccountEmail" required maxlength="70" style="padding: 0.6rem 0.75rem;">
            </div>
            <div class="mb-3">
                <label class="form-label text-secondary fw-medium fs-6">Password</label>
                <input type="password" class="form-control rounded-3 shadow-sm border-gray" id="AccountPassword" required maxlength="70" style="padding: 0.6rem 0.75rem;">
            </div>
            <div class="mb-4">
                <label class="form-label text-secondary fw-medium fs-6">Role</label>
                <select class="form-select rounded-3 shadow-sm border-gray" id="AccountRole" style="padding: 0.6rem 0.75rem;">
                    <option value="1">Staff</option>
                    <option value="2">Lecturer</option>
                </select>
            </div>
        </form>
      </div>
      <div class="modal-footer border-top-0 px-4 pb-4 pt-0">
        <button type="button" class="btn btn-light rounded-3 px-4 fw-medium" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary rounded-3 px-4 fw-medium shadow-sm" style="background-color: #4f46e5; border-color: #4f46e5;" onclick="saveAccount()">Save Account</button>
      </div>
    </div>
  </div>
</div>

<style>
    .border-gray {
        border: 1px solid #d1d5db;
    }
    .table-hover tbody tr:hover {
        background-color: #f9fafb !important;
    }
</style>

@section Scripts {
    <script>
        let isEditMode = false;
        const modal = new bootstrap.Modal(document.getElementById('accountModal'));

        function openCreateModal() {
            isEditMode = false;
            document.getElementById('modalTitle').innerText = 'Create Account';
            document.getElementById('accountForm').reset();
            document.getElementById('AccountID').value = '0';
            modal.show();
        }

        function openEditModal(id) {
            isEditMode = true;
            document.getElementById('modalTitle').innerText = 'Edit Account';
            
            $.get('/SystemAccounts/GetAccount/' + id, function (data) {
                document.getElementById('AccountID').value = data.accountID;
                document.getElementById('AccountName').value = data.accountName;
                document.getElementById('AccountEmail').value = data.accountEmail;
                document.getElementById('AccountPassword').value = data.accountPassword;
                document.getElementById('AccountRole').value = data.accountRole;
                modal.show();
            }).fail(function() {
                Swal.fire('Error', 'Could not load account data', 'error');
            });
        }

        function saveAccount() {
            if(!document.getElementById('accountForm').checkValidity()){
                document.getElementById('accountForm').reportValidity();
                return;
            }

            const data = {
                accountID: parseInt(document.getElementById('AccountID').value),
                accountName: document.getElementById('AccountName').value,
                accountEmail: document.getElementById('AccountEmail').value,
                accountPassword: document.getElementById('AccountPassword').value,
                accountRole: parseInt(document.getElementById('AccountRole').value)
            };

            const url = isEditMode ? '/SystemAccounts/Update' : '/SystemAccounts/Create';
            const method = isEditMode ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    modal.hide();
                    Swal.fire({
                        title: 'Success', 
                        text: res.message, 
                        icon: 'success',
                        confirmButtonColor: '#4f46e5'
                    }).then(() => location.reload());
                },
                error: function (err) {
                    Swal.fire('Error', err.responseText || 'An error occurred', 'error');
                }
            });
        }

        function deleteAccount(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/SystemAccounts/Delete/' + id,
                        type: 'DELETE',
                        success: function (res) {
                            Swal.fire({
                                title: 'Deleted!', 
                                text: res.message, 
                                icon: 'success',
                                confirmButtonColor: '#4f46e5'
                            }).then(() => location.reload());
                        },
                        error: function (err) {
                            Swal.fire('Error', err.responseJSON?.message || 'Failed to delete account', 'error');
                        }
                    });
                }
            })
        }
    </script>
}
